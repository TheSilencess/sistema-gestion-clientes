# PostgreSQL. No subas credenciales reales al repositorio.
DATABASE_URL="postgresql://gift:gift@localhost:5432/gift?schema=public"
# URL pública exacta. En producción debe usar HTTPS.
APP_URL="http://127.0.0.1:3000"
# Carpeta persistente de adjuntos. En Docker se monta /app/uploads.
UPLOAD_DIR="./.local/files"
# Solo activar durante la configuración inicial, con acceso restringido al servicio.
# Desactivar después de crear el primer administrador.
ALLOW_INITIAL_SETUP="false"
